# AI Home Finder — Environment Variables

# Copy this file to .env.local and fill in values as needed.
# No variables are required for the V1 MVP (mock data only).

# Future: Google Maps API key for commute calculations
# GOOGLE_MAPS_API_KEY=

# Future: Property listing API endpoint
# PROPERTY_API_URL=

# Future: ML recommendation service endpoint
# ML_API_URL=

# Property provider — data source for property listings
# Options: mock (default), property24, private-property, gumtree, scraped
NEXT_PUBLIC_PROPERTY_PROVIDER=mock
