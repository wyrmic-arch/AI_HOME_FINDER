# Business Pulse - Environment Variables Configuration

# Server configuration
PORT=3000
SESSION_SECRET=super_secret_session_key_change_me
ADMIN_PASSWORD=admin_password_123

# SQLite database file path
DB_PATH=data/pulse.db

# Google Places API Key (for Google review tracking)
GOOGLE_API_KEY=your_google_places_api_key_here

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=alerts@businesspulse.com
SMTP_FROM_NAME="Business Pulse Alerts"
